rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for User Profile
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.email is string &&
        data.email.size() <= 200 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000));
    }

    // Validation for User Progression
    function isValidProgression(data, userId) {
      return data.userId == userId &&
        data.id is string &&
        data.id.size() <= 128 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.genre is string &&
        data.genre.size() <= 40 &&
        data.chords is list &&
        data.chords.size() <= 64 &&
        data.tempoBpm is number &&
        data.tempoBpm >= 40 &&
        data.tempoBpm <= 280 &&
        (!('instrument' in data) || (data.instrument is string && data.instrument.size() <= 20));
    }

    // Users Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Users cannot list other users
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().email == existing().email;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Progressions Subcollection: /users/{userId}/progressions/{progressionId}
      match /progressions/{progressionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(progressionId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(progressionId) &&
          isValidProgression(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(progressionId) &&
          isValidProgression(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(progressionId);
      }
    }
  }
}
